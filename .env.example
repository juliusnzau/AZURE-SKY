# Azure Sky configuration. Local defaults below; see README "Going live" for production values (NODE_ENV=production,
# PUBLIC_URL=https://your-domain, strong JWT_SECRET/CALLBACK_SECRET, PAYMENTS_SIMULATE=false).
NODE_ENV=development
PORT=4000
PUBLIC_URL=http://localhost:8080
DATABASE_URL=postgres://azure:azure@postgres:5432/azuresky
REDIS_URL=redis://redis:6379
JWT_SECRET=change-me-to-a-long-random-string
UPLOAD_DIR=/data/uploads
COMMISSION_RATE=0.03
AUTO_RELEASE_DAYS=7
PAYMENT_TIMEOUT_MINUTES=30
VAT_RATE=0.16
DELIVERY_FEE_KES=200
# Secret path segment protecting payment callback URLs
CALLBACK_SECRET=change-me-random
# SMTP (leave SMTP_HOST empty in dev to just log emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Azure Sky <no-reply@azuresky.co.ke>"
# M-Pesa Daraja
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_INITIATOR_NAME=
MPESA_SECURITY_CREDENTIAL=
# Airtel Money Open API
AIRTEL_ENV=sandbox
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
# "true" simulates payments locally (no real calls to Safaricom/Airtel). MUST be false in production.
PAYMENTS_SIMULATE=true
# First admin (created on boot if missing)
ADMIN_EMAIL=admin@azuresky.co.ke
ADMIN_PASSWORD=ChangeMeNow!123
